<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Coin\Domain\Coin" table="coins">
        <id name="id" type="coin_id" column="id" length="36"/>

        <embedded name="value" class="App\Coin\Domain\CoinValue" use-column-prefix="false"/>
        <embedded name="quantity" class="App\Coin\Domain\CoinQuantity" use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
