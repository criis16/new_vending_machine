<?xml version="1.0" encoding="UTF-8"?>
<doctrine-mapping xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                  xmlns="http://doctrine-project.org/schemas/orm/doctrine-mapping"
                  xsi:schemaLocation="http://doctrine-project.org/schemas/orm/doctrine-mapping
                          https://www.doctrine-project.org/schemas/orm/doctrine-mapping.xsd">

    <entity name="App\Item\Domain\Item" table="items">
        <id name="id" type="item_id" column="id" length="36"/>

        <embedded name="name" class="App\Item\Domain\ItemName" use-column-prefix="false"/>
        <embedded name="price" class="App\Item\Domain\ItemPrice" use-column-prefix="false"/>
        <embedded name="quantity" class="App\Item\Domain\ItemQuantity" use-column-prefix="false"/>
    </entity>

</doctrine-mapping>
